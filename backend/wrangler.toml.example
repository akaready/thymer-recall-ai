name = "thymer-recall-bridge"
main = "bridge-worker.js"
compatibility_date = "2026-05-05"

# The bridge can run without secrets because the plugin sends isolated keys
# per request. Uncomment these if you prefer server-side defaults.
# [vars]
# ANTHROPIC_MODEL = "claude-sonnet-4-5"
#
# Set secrets with:
# wrangler secret put RECALL_API_KEY
# wrangler secret put ANTHROPIC_API_KEY

# Optional, but recommended for reliable live transcript buffering.
# Create with: wrangler kv namespace create RECALL_TRANSCRIPTS
# [[kv_namespaces]]
# binding = "RECALL_TRANSCRIPTS"
# id = "replace-with-namespace-id"
